{
 "cleanUrls": true,
 "crons": [
  {
   "path": "/api/lembretes",
   "schedule": "0 21 * * *"
  }
 ],
 "headers": [
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    },
    {
     "key": "Service-Worker-Allowed",
     "value": "/"
    }
   ]
  },
  {
   "source": "/(.*).webmanifest",
   "headers": [
    {
     "key": "Content-Type",
     "value": "application/manifest+json"
    }
   ]
  },
  {
   "source": "/painel",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex"
    }
   ]
  }
 ],
 "redirects": [
  {
   "source": "/admin",
   "destination": "/painel",
   "permanent": true
  },
  {
   "source": "/adm",
   "destination": "/painel",
   "permanent": true
  },
  {
   "source": "/barbeiro",
   "destination": "/painel",
   "permanent": true
  }
 ]
}